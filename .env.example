# Cutflux Cloud Run Backend Environment Configuration

# Server Port
PORT=8080

# Admin Analytics Dashboard PIN (matches client-side 6-tap prompt)
VEP_ADMIN_UNLOCK_PIN=8842

# Pexels Video Stock API Key (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Stripe Billing & Checkout
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/...

# RevenueCat API (Native iOS/Android in-app purchases)
REVENUECAT_API_KEY=

# AssemblyAI Speech-to-Text (Music Lyric / Video Captions)
ASSEMBLYAI_API_KEY=

# Resend / Email Provider (Desktop magic link handoff & Support form)
RESEND_API_KEY=
SUPPORT_EMAIL=hello@cutflux.app

# Firebase Admin Service Account (JSON file path or stringified JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=
